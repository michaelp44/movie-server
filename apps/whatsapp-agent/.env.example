# Start in the terminal first. Change to "whatsapp" only after reading README.md.
AGENT_TRANSPORT=console

# OpenAI Responses API
OPENAI_API_KEY=
WHATSAPP_AGENT_MODEL=gpt-5.6-luna

# Agent behavior
WHATSAPP_AGENT_PREFIX=!agent
WHATSAPP_AGENT_TIMEZONE=Asia/Jerusalem
WHATSAPP_AGENT_DATA_DIR=./data/whatsapp-agent
WHATSAPP_AGENT_WORKSPACE_ROOT=.
WHATSAPP_AGENT_TASKS_FILE=./apps/whatsapp-agent/tasks.json

# Personal WhatsApp Web mode (unofficial and carries account/availability risk).
# The agent will refuse to start this transport until the exact acknowledgement is set.
WHATSAPP_UNOFFICIAL_WEB_AUTOMATION_ACK=
WHATSAPP_SESSION_DIR=./data/whatsapp-agent/whatsapp-session
WHATSAPP_HEADLESS=true
# Dedicated wedding sender: exposes only the localhost wedding send endpoint and
# does not inspect chats, groups, commands, reactions, Calendar, or Sheets workflows.
WHATSAPP_WEDDING_ONLY=false
# Localhost-only bridge used by the wedding admin's supervised one-click sends.
# It authenticates with WEDDING_FALLBACK_SECRET (environment or macOS Keychain).
WEDDING_WHATSAPP_CONTROL_PORT=8790
WEDDING_CAMPAIGN_WORKER_ENABLED=false
WEDDING_CAMPAIGN_WORKER_URL=https://wedding.my-rem.com/api/internal/campaigns/process
WEDDING_CAMPAIGN_WORKER_SECRET=
WEDDING_CAMPAIGN_WORKER_POLL_SECONDS=30

# Chat IDs or phone numbers the read_recent_whatsapp_messages tool may inspect.
# Empty means it cannot read any non-owner chats. Names are intentionally unsupported.
# Example: 972501234567,120363000000000000@g.us
WHATSAPP_READ_ALLOWLIST=
WHATSAPP_RECENT_MESSAGE_LIMIT=20

# Optional automatic meeting monitor. Resolve the name once, then prefer the stable group ID.
WHATSAPP_MONITOR_GROUP_NAME=
WHATSAPP_MONITOR_GROUP_ID=
WHATSAPP_MONITOR_CONTEXT_MESSAGES=30
WHATSAPP_MONITOR_DEBOUNCE_SECONDS=8
# Images are downloaded into memory only. Limit the newest images and their decoded size.
WHATSAPP_MONITOR_IMAGE_LIMIT=3
WHATSAPP_MONITOR_MAX_IMAGE_MB=5
WHATSAPP_MONITOR_CLARIFICATION_COOLDOWN_HOURS=12

# Optional AnyList integration through a Siri Shortcut synced to this Mac. The agent runs the
# shortcut locally for each accepted item and sends one compact private confirmation.
ANYLIST_MONITOR_ENABLED=false
ANYLIST_SHORTCUT_NAME=Add to קניות בסופר

# Optional Google Sheets update monitor. Only messages beginning with "עדכון:" in the exact
# configured group are processed. The target spreadsheet and tab are fixed; prompts cannot
# redirect the agent to another file. Use a separate OAuth token with Sheets-only access.
GOOGLE_SHEETS_UPDATE_MONITOR_ENABLED=false
GOOGLE_SHEETS_UPDATE_GROUP_NAME=
GOOGLE_SHEETS_UPDATE_GROUP_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=קניות
GOOGLE_SHEETS_CREDENTIALS_PATH=./data/whatsapp-agent/google-oauth-client.json
GOOGLE_SHEETS_TOKEN_PATH=./data/whatsapp-agent/google-sheets-oauth-token.json
GOOGLE_SHEETS_OAUTH_PORT=42814
GOOGLE_SHEETS_MAX_CHANGES=20

# Google Calendar. OAuth files stay under the ignored private agent data directory.
GOOGLE_CALENDAR_AUTO_CREATE=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_PATH=./data/whatsapp-agent/google-oauth-client.json
GOOGLE_CALENDAR_TOKEN_PATH=./data/whatsapp-agent/google-oauth-token.json
GOOGLE_CALENDAR_ATTENDEE=shoval18995@gmail.com
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=60
GOOGLE_CALENDAR_APPROVAL_TTL_HOURS=24
GOOGLE_CALENDAR_OAUTH_PORT=42813
